
##############################
# GATEWAY SERVICE ARGS
##############################
# TLS: basename of the Tailscale cert pair in ./certs (<TLS_HOST>.crt / .key)
# PC: <pc-host>.<tailnet>.ts.net   Pi: <pi-host>.<tailnet>.ts.net
TLS_HOST=

# MQTT
# PC: <pi-host> (over Tailscale). Pi, broker on the same box: host.docker.internal
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# JWT SECRET KEY FOR HASHING
JWT_SECRET_KEY=

# Redis (compose service name; use 127.0.0.1 only when running on the host)
REDIS_URL=redis://redis:6379/0

# API Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"] # NOTE: currently unused; CORS origins are hard-coded in services/gateway/main.py

# Agent -> Gateway (gateway serves HTTPS)
GATEWAY_URL=https://gateway:8000

# Gateway scheduler -> agent internal endpoints (optional; this is the default)
# AGENT_INTERNAL_URL=http://agent:8001

# =========================================================
# DATABASE ARGS
# =========================================================

DB_USER=
DB_PASSWORD=
# e.g. postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@postgres:5432/home_os
DATABASE_URL=

#################################################
# AGENT SERVICE ARGS
#################################################

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

#################################################
# SPOTIFY TOOL SETTINGS
#################################################

# Required for API authentication (Authorization Code Flow)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the Spotify developer app
SPOTIFY_REDIRECT_URI=